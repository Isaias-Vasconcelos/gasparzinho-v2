@model Gasparzinho.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Entrar";
    Layout = "_AuthLayout";
}

<h1>Modera<span style="color:var(--accent)">Hub</span></h1>
<p class="page-subtitle">Acesse com o usuário e a senha que você recebeu.</p>

<form asp-action="Login" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="alert alert-error validation-summary-errors"></div>

    <div class="field">
        <label asp-for="Username"></label>
        <input asp-for="Username" autocomplete="username" autofocus />
        <span asp-validation-for="Username" class="field-validation-error"></span>
    </div>

    <div class="field">
        <label asp-for="Password"></label>
        <input asp-for="Password" autocomplete="current-password" />
        <span asp-validation-for="Password" class="field-validation-error"></span>
    </div>

    <div class="field checkbox">
        <input asp-for="RememberMe" type="checkbox" />
        <label asp-for="RememberMe"></label>
    </div>

    <button type="submit" class="btn">Entrar</button>
</form>

<div class="auth-alt muted">
    Não tem acesso? Solicite ao administrador do sistema.
</div>
