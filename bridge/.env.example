# Porta da bridge
PORT=3002

# URL do ASP.NET MVC, para onde os eventos do WhatsApp são enviados
APP_URL=http://localhost:5000

# Segredo compartilhado — precisa ser idêntico ao Bridge:Token do .NET
BRIDGE_TOKEN=TKN12345678

# Pasta das credenciais das sessões (reaproveite a pasta antiga para não perder conexões)
SESSIONS_PATH=./data/sessions
